{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KubeHive",
  "version": "0.1.0",
  "identifier": "dev.kubehive.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "KubeHive",
      "width": 1440,
      "height": 920,
      "minWidth": 960,
      "minHeight": 640,
      "decorations": true,
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "transparent": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3Q0Y3MUFDQjVFMDUzODIKUldTQ1UrQzFySEhQUnhCcEN0VkkvUU55RFltT0FBSXc4L1JhQU84cFR2c2pzZEpxZ3Q0b2hQTWEK",
      "endpoints": ["https://github.com/poneding/kubehive/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
