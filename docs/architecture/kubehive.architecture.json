  "cards": [
    {
      "dot": "cyan",
      "title": "UI boundary",
      "items": [
        "React renders the desktop workspace and contains no synthetic cluster data",
        "Live-cluster operations require the native Tauri command boundary"
      ]
    },
    {
      "dot": "emerald",
      "title": "Native data plane",
      "items": [
        "Tauri commands expose discovery, list/watch, details, and controlled writes",
        "kube-rs communicates with each selected Kubernetes API server"
      ]
    },
    {
      "dot": "rose",
      "title": "Credential handling",
      "items": [
        "Kubeconfig and tokens stay in the Rust-native boundary",
        "Kubernetes RBAC remains the final authorization authority"
      ]
    }
  ]
